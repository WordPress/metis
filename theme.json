		"typography": {
			"fontFamily": "var(--wp--preset--font-family--recursive-linear)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontStyle": "normal",
			"fontWeight": "400",
			"letterSpacing": "-0.01rem",
			"lineHeight": "1.6"
