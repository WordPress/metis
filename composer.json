{
	"name": "wordpress/metis",
	"type": "wordpress-theme",
	"description": "Development tooling for Metis, an official WordPress theme.",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Contributors"
		}
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"scripts": {
		"format": "phpcbf --standard=tools/phpcs-ruleset.xml --report-summary --report-source",
		"lint": "phpcs --standard=tools/phpcs-ruleset.xml"
	}
}
