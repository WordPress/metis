{
	"name": "metis",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"check": "node tools/run-checks.mjs",
		"wp-env": "wp-env",
		"env:setup": "wp-env start && wp-env run cli wp theme activate metis && wp-env run cli wp plugin install theme-check --activate",
		"env:start": "wp-env start",
		"env:status": "wp-env status",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean all",
		"verify:css": "stylelint \"**/*.css\" --ignore-pattern \"node_modules/**\" --ignore-pattern \"vendor/**\"",
		"verify:json": "node tools/lint-json.mjs",
		"verify:php": "composer run lint",
		"verify:php-syntax": "node tools/lint-php-syntax.mjs",
		"fix:css": "npm run verify:css -- --fix",
		"fix:php": "composer run format"
	},
	"devDependencies": {
		"@wordpress/env": "^11.13.0",
		"@wordpress/stylelint-config": "^24.2.0",
		"stylelint": "^16.26.1"
	}
}
